{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": false
  },
  "include": ["server/worker.ts", "server/app.ts", "server/tournament.ts", "server/brackets.ts", "server/store/supabase.ts", "server/store/types.ts", "server/store/withTournament.ts", "shared/**/*.ts"],
  "exclude": ["**/*.test.ts"]
}
