{
  "name": "gigalan",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsx --watch server/index.ts\"",
    "dev:client": "vite",
    "dev:server": "tsx --watch server/index.ts",
    "build": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "deploy:cf": "npm run build && wrangler deploy",
    "dev:cf": "npm run build && wrangler dev",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.server.json && tsc -p tsconfig.worker.json",
    "start:server": "tsx server/index.ts",
    "gen-token": "tsx scripts/gen-token.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@playwright/test": "^1.61.1",
    "@sveltejs/vite-plugin-svelte": "6.2.1",
    "@tsconfig/svelte": "5.0.6",
    "@types/node": "24.10.1",
    "autoprefixer": "10.4.22",
    "chart.js": "^4.4.1",
    "concurrently": "9.2.1",
    "postcss": "8.5.6",
    "svelte": "5.43.14",
    "svelte-check": "4.3.4",
    "tailwindcss": "3.4.17",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vite": "7.2.4",
    "vitest": "^4.1.10",
    "wrangler": "^4.129.1"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@supabase/supabase-js": "^2.116.0",
    "hono": "^4.13.7",
    "redis": "5.10.0",
    "uuid": "13.0.0"
  }
}
